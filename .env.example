# ============================================================
# Campus Placement AI — Server Environment Variables
# ============================================================
# Copy this file to server/.env and fill in your values.
# NEVER commit server/.env to version control.
# ============================================================

# ── Azure AI Foundry ─────────────────────────────────────────────────────────
AZURE_AI_ENDPOINT=https://your-project.services.ai.azure.com/api/projects/YOUR-PROJECT
AZURE_AI_KEY=your_azure_ai_api_key
AZURE_AGENT_ID=CampusPlacementAgent

# ── JWT Authentication ────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_at_least_64_chars

# ── SMTP Email Configuration (required for OTP delivery) ─────────────────────
#
# OPTION A — Gmail (recommended for demo/development)
# -------------------------------------------------------
# 1. Enable 2-Step Verification on your Google account:
#    https://myaccount.google.com/security
# 2. Generate an App Password:
#    Google Account → Security → App Passwords → Select app: Mail
# 3. Use the 16-character App Password below (NOT your Google password)
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=youremail@gmail.com
# SMTP_PASSWORD=abcd efgh ijkl mnop   (16-char App Password, spaces OK)
# SMTP_FROM=Campus Placement AI <youremail@gmail.com>
#
# OPTION B — Other providers (Outlook, Office365, custom SMTP)
# -------------------------------------------------------
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@domain.com
# SMTP_PASSWORD=your_smtp_password
# SMTP_FROM=Campus Placement AI <your@domain.com>
#
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Campus Placement AI <noreply@campusplacementai.com>

# ── Educational Domain Configuration ─────────────────────────────────────────
# Extra domains to approve (comma-separated), in addition to built-in list.
# Example: EXTRA_EDU_DOMAINS=myuniversity.ac.in,anothercollege.edu.in
EXTRA_EDU_DOMAINS=

# ── OTP Configuration (optional — shown with defaults) ───────────────────────
OTP_EXPIRES_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_REQUESTS_PER_EMAIL=5
OTP_MAX_REQUESTS_PER_IP=20
OTP_RATE_LIMIT_WINDOW_MINUTES=15
OTP_MAX_VERIFY_ATTEMPTS=5

# ── SMS / Twilio Configuration ────────────────────────────────────────────────
#
# Provider: Twilio  (https://www.twilio.com)
#
# Setup:
#   1. Create a free account at https://www.twilio.com/try-twilio
#   2. In the Twilio Console → Account Info, copy:
#      - Account SID  (starts with "AC...")
#      - Auth Token
#   3. Get a Twilio phone number:
#      - Free trial: use the sandbox number provided.
#      - Production: buy an Indian DLT-registered number or use Twilio India.
#   4. For Indian numbers, Twilio supports +91 mobile numbers.
#      Trial accounts can only send to "Verified Caller IDs" (your own number).
#      Upgrade to send to any number.
#
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890

# ── SMS Rate Limits ───────────────────────────────────────────────────────────
SMS_RESEND_COOLDOWN_SECONDS=60
SMS_MAX_REQUESTS_PER_PHONE=3

# ── SMS Development Mode ──────────────────────────────────────────────────────
# DEVELOPMENT ONLY — print OTP to server console instead of sending real SMS.
# Set to false (or remove) in production. OTP is NEVER returned via API.
SMS_OTP_DEV_MODE=false
